# Local/non-serverless only. Vercel does not need PORT to be set manually.
PORT=5001
NODE_ENV=development

# Security & Secrets
GATEWAY_SECRET=replace_with_auth_service_only_secret
JWT_REFRESH_SECRET=refresh_token_super_secret_key_change_me

# Database
DATABASE_URL=postgresql://postgres:admin@localhost:5432/akura_auth?schema=public

# JWT
# Use JWT_ACCESS_PRIVATE_KEY_BASE64 in Vercel/production, or JWT_ACCESS_PRIVATE_KEY_PATH for local files.
JWT_ACCESS_PRIVATE_KEY_PATH=keys/access-private.pem
# JWT_ACCESS_PRIVATE_KEY_BASE64=base64_encoded_access_private_key
JWT_ACCESS_KEY_ID=akura-access-key-1
JWT_ISSUER=akura-auth
JWT_AUDIENCE=akura-api
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_IDLE_TIMEOUT_MINUTES=60

# Direct browser access on loopback only; ignored in production/Vercel.
LOCAL_DIRECT_ACCESS=true
