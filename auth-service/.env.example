# ==========================================
# Akura - Auth Service
# ==========================================
# Copy this file to `.env` and replace every placeholder with a real value:
#
#   cp .env.example .env
#
# The `.env` file is git-ignored and must never be committed.
#
# This file documents the DEVELOPMENT configuration. Every value points at a
# local service, so running the service locally can never reach a deployed
# system. For a deployment, set the variables in the hosting dashboard
# instead; do not copy this file to the server.
#
# Generate a secret with:
#   openssl rand -base64 48
#
# ==========================================

# ==========================================
# Server
# ==========================================
# Local/non-serverless only. Vercel does not need PORT to be set manually.
PORT=5001
NODE_ENV=development

# ==========================================
# Security & Secrets
# ==========================================
# Must match AUTH_SERVICE_GATEWAY_SECRET in the API Gateway.
GATEWAY_SECRET=replace_with_auth_service_only_secret
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_REFRESH_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# ==========================================
# Database
# ==========================================
# The local development database. Never point this at a deployed database.
DATABASE_URL=postgresql://postgres:admin@localhost:5432/akura_auth?schema=public

# ==========================================
# JWT
# ==========================================
# Use JWT_ACCESS_PRIVATE_KEY_BASE64 in Vercel/production, or JWT_ACCESS_PRIVATE_KEY_PATH for local files.
JWT_ACCESS_PRIVATE_KEY_PATH=keys/access-private.pem
# JWT_ACCESS_PRIVATE_KEY_BASE64=base64_encoded_access_private_key
JWT_ACCESS_KEY_ID=akura-access-key-1
JWT_ISSUER=akura-auth
JWT_AUDIENCE=akura-api
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_IDLE_TIMEOUT_MINUTES=60

# ==========================================
# Service Endpoints
# ==========================================
# The local API Gateway. Used for the user read-model sync delivery.
API_GATEWAY_URL=http://localhost:5000

# ==========================================
# Cross-service shared secrets
# ==========================================
# Shared with Marketing, Field Service and Finance for the read-model sync
# deliveries. Must be at least 32 characters, and identical in every service
# that takes part in the same delivery.
USER_SYNC_SECRET=replace-with-shared-secret-at-least-32-characters