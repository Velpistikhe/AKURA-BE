datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserSection {
  ACCOUNTING
  FINANCE
  HRD_MANAGEMENT
  MARKETING
  FIELD_SERVICE

  @@map("user_section")
}

enum UserRole {
  USER
  ADMIN
  APP_MANAGER

  @@map("user_role")
}


model User {
  id                String         @id @default(uuid()) @db.Uuid
  username          String
  normalizeUsername String         @unique @map("normalize_username")
  firstName         String         @map("first_name")
  lastName          String         @map("last_name")
  email             String?        @db.VarChar(255)
  telp              String?        @db.VarChar(50)
  role              UserRole       @default(USER)
  section           UserSection?
  officeBranchId    String?        @map("office_branch_id") @db.Uuid
  isActive          Boolean        @default(true) @map("is_active")
  version           Int            @default(1)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  password          UserPassword?
  refreshTokens     RefreshToken[]

  @@index([officeBranchId])
  @@map("users")
}


model UserPassword {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String   @map("password_hash")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("user_passwords")
}


model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String   @map("family_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model UserSyncEvent {
  id           String             @id @default(uuid()) @db.Uuid
  userId       String             @map("user_id") @db.Uuid
  version      Int
  /// Full user snapshot required by the Marketing read model.
  payload      Json               @db.JsonB
  createdAt    DateTime           @default(now()) @map("created_at")
  deliveries   UserSyncDelivery[]

  @@unique([userId, version])
  @@map("user_sync_events")
}

model UserSyncDelivery {
  id            String        @id @default(uuid()) @db.Uuid
  eventId       String        @map("event_id") @db.Uuid
  event         UserSyncEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  targetService String        @map("target_service")
  attempts      Int           @default(0)
  nextRetryAt   DateTime      @default(now()) @map("next_retry_at")
  deliveredAt   DateTime?     @map("delivered_at")
  lastError     String?       @map("last_error")

  @@unique([eventId, targetService])
  @@index([deliveredAt, nextRetryAt])
  @@map("user_sync_deliveries")
}
