datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserSection {
  ACCOUNTING
  FINANCE
  HRD_MANAGEMENT
  MARKETING
  FIELD_SERVICE

  @@map("user_section")
}

enum UserRole {
  USER
  ADMIN
  APP_MANAGER

  @@map("user_role")
}


model User {
  id                String         @id @default(uuid()) @db.Uuid
  username          String
  normalizeUsername String         @unique @map("normalize_username")
  firstName         String         @map("first_name")
  lastName          String         @map("last_name")
  email             String?        @db.VarChar(255)
  telp              String?        @db.VarChar(50)
  role              UserRole       @default(USER)
  section           UserSection?
  officeBranchId    String?        @map("office_branch_id") @db.Uuid
  officeBranchName  String?        @map("office_branch_name") @db.VarChar(200)
  isActive          Boolean        @default(true) @map("is_active")
  version           Int            @default(1)
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  password          UserPassword?
  refreshTokens     RefreshToken[]
  history           UserHistory[]

  @@index([officeBranchId])
  @@map("users")
}


model UserHistory {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version        Int
  action         String   @db.VarChar(20)
  beforeSnapshot Json?    @map("before_snapshot") @db.JsonB
  snapshot       Json     @db.JsonB
  changes        Json     @db.JsonB
  createdById    String   @map("created_by_id") @db.Uuid
  createdByName  String   @map("created_by_name")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, version])
  @@map("user_histories")
}


model UserPassword {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  passwordHash String   @map("password_hash")
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("user_passwords")
}


model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  familyId  String   @map("family_id") @db.Uuid
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  isRevoked Boolean  @default(false) @map("is_revoked")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Audit trail for the events that are not user-profile edits.
///
/// The user profile changes are recorded in `UserHistory`. This table covers
/// the security-relevant events of the other modules: registrations, logins,
/// failed logins, token refreshes and logouts. A single generic table keeps
/// the audit trail uniform across the whole platform, so a new module is
/// audited without a schema migration.
///
/// The rows are append-only: there is no update or delete path in the
/// application.
model SecurityAuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  module         String   @db.VarChar(50)
  eventType      String   @map("event_type") @db.VarChar(50)
  action         String   @db.VarChar(20)
  userId         String?  @map("user_id") @db.Uuid
  username       String?  @db.VarChar(100)
  officeBranchId String?  @map("office_branch_id") @db.Uuid
  ipAddress      String?  @map("ip_address") @db.VarChar(64)
  userAgent      String?  @map("user_agent") @db.VarChar(300)
  outcome        String   @db.VarChar(20)
  detail         Json?    @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([module, eventType, createdAt])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("security_audit_logs")
}