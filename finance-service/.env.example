PORT=5004
NODE_ENV=development
GATEWAY_SECRET=replace_with_finance_service_only_secret
API_GATEWAY_URL=http://localhost:5000
JWT_ISSUER=akura-auth
JWT_AUDIENCE=akura-api
DATABASE_URL=postgresql://postgres:password@localhost:5432/akura_finance?schema=public

# Dedicated credential for Finance-to-consumer tax delivery
TAX_SYNC_SECRET=replace-with-shared-secret-at-least-32-characters
TAX_DELIVERY_TARGETS=[{"name":"marketing-service","url":"http://localhost:5003/internal/taxes/events"}]
