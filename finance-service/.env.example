# Local/non-serverless only. Vercel does not need PORT to be set manually.
PORT=5004
NODE_ENV=development

# Security & Secrets
GATEWAY_SECRET=replace_with_finance_service_only_secret
TAX_SYNC_SECRET=replace-with-shared-secret-at-least-32-characters

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/akura_finance?schema=public

# JWT
JWT_ISSUER=akura-auth
JWT_AUDIENCE=akura-api

# Service Endpoints
API_GATEWAY_URL="https://akura-api-gateway.vercel.app"
TAX_DELIVERY_TARGETS=[{"name":"marketing-service","url":"http://localhost:5003/internal/taxes/events"}]

# Direct browser access on loopback only; ignored in production/Vercel.
LOCAL_DIRECT_ACCESS=true
AUTH_SERVICE_URL="https://akura-auth-service.vercel.app"
MARKETING_SERVICE_URL="https://akura-marketing-service.vercel.app"
AUTH_SERVICE_GATEWAY_SECRET="replace_with_deployed_auth_service_secret"
MARKETING_SERVICE_GATEWAY_SECRET="replace_with_deployed_marketing_service_secret"
