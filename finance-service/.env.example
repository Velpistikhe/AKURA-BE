# ==========================================
# Akura - Finance Service
# ==========================================
# Copy this file to `.env` and replace every placeholder with a real value:
#
#   cp .env.example .env
#
# The `.env` file is git-ignored and must never be committed.
#
# This file documents the DEVELOPMENT configuration. Every value points at a
# local service, so running the service locally can never reach a deployed
# system. For a deployment, set the variables in the hosting dashboard
# instead; do not copy this file to the server.
#
# Generate a secret with:
#   openssl rand -base64 48
#
# ==========================================

# ==========================================
# Server
# ==========================================
PORT=5004
NODE_ENV=development

# ==========================================
# Security & Secrets
# ==========================================
# Must match FINANCE_SERVICE_GATEWAY_SECRET in the API Gateway.
GATEWAY_SECRET=replace_with_finance_service_only_secret
# Shared with Marketing for the tax read-model delivery (min 32 chars).
TAX_SYNC_SECRET=replace-with-shared-secret-at-least-32-characters

# ==========================================
# Development direct access
# ==========================================
# The local Finance microfrontend calls this service directly (localhost:5004)
# with Authorization: Bearer instead of the local gateway. JWT, profile,
# section/role and branch checks remain mandatory. Set true only in
# development; production/Vercel must keep this false.
# DIRECT_MFE_ORIGIN is the only browser origin allowed to call directly.
DIRECT_MFE_ACCESS=false
DIRECT_MFE_ORIGIN=http://localhost:4173

# ==========================================
# Database
# ==========================================
# The local development database. Never point this at a deployed database.
DATABASE_URL=postgresql://postgres:admin@localhost:5432/akura_finance?schema=public

# ==========================================
# JWT
# ==========================================
JWT_ISSUER=akura-auth
JWT_AUDIENCE=akura-api

# ==========================================
# Service Endpoints
# ==========================================
# The local API Gateway.
API_GATEWAY_URL=http://localhost:5000

# ==========================================
# Tax delivery targets
# ==========================================
# The services that receive the tax snapshot. The URL must point at the local
# gateway, and TAX_SYNC_SECRET must be set when this list is not empty.
TAX_DELIVERY_TARGETS=[{"name":"marketing-service","url":"http://localhost:5000/api/v1/marketing/internal/taxes/events"}]