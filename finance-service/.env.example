PORT=5004
NODE_ENV=development
# Hosts this development run may reach besides the local machine. The hosted
# development environment (the Neon branch and the deployed services) is listed
# here by name, so an unlisted target is still refused at startup.
# Comma-separated host names, for example: ep-xxx.us-east-2.aws.neon.tech,akura-api-gateway.vercel.app
DEV_ALLOWED_REMOTE_HOSTS=

GATEWAY_SECRET=replace_with_finance_service_only_secret
TAX_SYNC_SECRET=replace-with-shared-secret-at-least-32-characters


DATABASE_URL=postgresql://postgres:admin@localhost:5432/akura_finance?schema=public

JWT_ISSUER=akura-auth
JWT_AUDIENCE=akura-api

API_GATEWAY_URL=http://localhost:5000

TAX_DELIVERY_TARGETS=[{"name":"marketing-service","url":"http://localhost:5000/api/v1/marketing/internal/taxes/events"}]