generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model TaxCache {
  id String @id @db.Uuid
  officeBranchId String @map("office_branch_id") @db.Uuid
  percentage Decimal @db.Decimal(5, 2)
  effectiveFrom DateTime @map("effective_from") @db.Date
  effectiveUntil DateTime? @map("effective_until") @db.Date
  sourceUpdatedAt DateTime @map("source_updated_at")
  @@index([officeBranchId, effectiveFrom])
  @@map("tax_cache")
}
model TaxSyncState {
  id String @id
  lastSuccessAt DateTime? @map("last_success_at")
  @@map("tax_sync_state")
}

model Tax {
  id             String @id @default(uuid()) @db.Uuid
  officeBranchId String @map("office_branch_id") @db.Uuid
  percentage     Decimal @db.Decimal(5, 2)
  effectiveFrom  DateTime @map("effective_from") @db.Date
  effectiveUntil DateTime? @map("effective_until") @db.Date
  createdById    String @map("created_by_id") @db.Uuid
  createdByName  String @map("created_by_name")
  updatedById    String? @map("updated_by_id") @db.Uuid
  updatedByName  String? @map("updated_by_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([officeBranchId, effectiveFrom])
  @@map("taxes")
}

model TaxRevision {
  officeBranchId String @id @db.Uuid
  version Int @default(0)
  @@map("tax_revisions")
}
model TaxEvent {
  id String @id @default(uuid()) @db.Uuid
  officeBranchId String @db.Uuid
  version Int
  payload Json @db.JsonB
  createdAt DateTime @default(now())
  deliveries TaxDelivery[]
  @@unique([officeBranchId, version])
  @@map("tax_events")
}
model TaxDelivery {
  id String @id @default(uuid()) @db.Uuid
  eventId String @db.Uuid
  event TaxEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  targetService String
  attempts Int @default(0)
  nextRetryAt DateTime @default(now())
  deliveredAt DateTime?
  lastError String?
  @@unique([eventId, targetService])
  @@index([deliveredAt, nextRetryAt])
  @@map("tax_deliveries")
}
