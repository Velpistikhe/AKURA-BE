{
  "name": "finance-service",
  "version": "1.0.0",
  "description": "Finance microservice for Akura",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && rimraf dist && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/service.test.cjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "test:documents": "npm run build && node --test tests/documents.test.cjs tests/documents-http.test.cjs tests/invoice-number.test.cjs tests/proforma-number.test.cjs",
    "tax:import": "node scripts/import-app-manager-taxes.cjs",
    "test:tax-delivery": "tsc && node --test tests/tax-delivery.test.cjs",
    "test:tax-serverless": "tsc && node --test tests/tax-serverless.test.cjs",
    "tax:schema": "node scripts/apply-tax-schema.cjs",
    "proforma:schema": "node scripts/apply-proforma-schema.cjs",
    "invoice:schema": "node scripts/apply-invoice-schema.cjs"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "helmet": "^7.2.0",
    "jose": "^6.1.0",
    "winston": "^3.19.0",
    "zod": "^3.25.76",
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "rimraf": "^5.0.10",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "prisma": "5.22.0"
  }
}
