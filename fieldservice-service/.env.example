PORT=5005
NODE_ENV=development

GATEWAY_SECRET=replace_with_fieldservice_service_only_secret
WORK_ORDER_SYNC_SECRET=replace-with-shared-secret-at-least-32-characters

# Fully local stack:
DATABASE_URL=postgresql://postgres:admin@localhost:5432/akura_fieldservice?schema=public
# Hybrid: local Field Service, Neon development branch (*.neon.tech is allowed in development).
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/akura_fieldservice?sslmode=require

JWT_ISSUER=akura-auth
JWT_AUDIENCE=akura-api

# Fully local stack:
API_GATEWAY_URL=http://localhost:5000
# Hybrid: validate tokens against the deployed gateway (akura-api-gateway.vercel.app).
# API_GATEWAY_URL=https://akura-api-gateway.vercel.app