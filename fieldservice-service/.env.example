# All API requests normally use the API Gateway in development and production.
# GATEWAY_SECRET must match this service credential in the gateway.
# Local/non-serverless only. Vercel does not need PORT to be set manually.
PORT=5005
NODE_ENV=development

# Security & Secrets
GATEWAY_SECRET=replace_with_fieldservice_service_only_secret
# Shared with Auth for FIELD_SERVICE user read-model delivery (min 32 chars).
USER_SYNC_SECRET=replace-with-shared-secret-at-least-32-characters

# Development direct access: the local Field Service microfrontend calls this
# service directly (localhost:5005) with Authorization: Bearer instead of the
# local gateway. JWT, profile, section/role and branch checks remain mandatory.
# Set true only in development; production/Vercel must keep this false.
# DIRECT_MFE_ORIGIN is the only browser origin allowed to call directly.
DIRECT_MFE_ACCESS=false
DIRECT_MFE_ORIGIN=http://localhost:4173

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/akura_fieldservice?schema=public

# JWT
JWT_ISSUER=akura-auth
JWT_AUDIENCE=akura-api

# Service Endpoints
API_GATEWAY_URL=http://localhost:5000
