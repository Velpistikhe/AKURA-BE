# All API traffic uses the API Gateway in development and production.
# GATEWAY_SECRET must match this service credential in the gateway.
# Local/non-serverless only. Vercel does not need PORT to be set manually.
PORT=5005
NODE_ENV=development

# Security & Secrets
GATEWAY_SECRET=replace_with_fieldservice_service_only_secret

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/akura_fieldservice?schema=public

# JWT
JWT_ISSUER=akura-auth
JWT_AUDIENCE=akura-api

# Service Endpoints
API_GATEWAY_URL=http://localhost:5000
