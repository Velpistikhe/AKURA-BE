{
  "name": "fieldservice-service",
  "version": "1.0.0",
  "description": "Field Service microservice for Akura",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && rimraf dist && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/service.test.cjs tests/work-order.test.cjs",
    "work-order:schema": "node scripts/apply-work-order-schema.cjs",
    "test:work-order": "tsc && node --test tests/work-order.test.cjs",
    "db:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "helmet": "^7.2.0",
    "jose": "^6.1.0",
    "winston": "^3.19.0",
    "zod": "^3.25.76",
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "rimraf": "^5.0.10",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "prisma": "5.22.0"
  }
}
