generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum WorkOrderStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELED
  @@map("WorkOrderStatus")
}

model WorkOrder {
  id String @id @default(uuid()) @db.Uuid
  officeBranchId String @map("office_branch_id") @db.Uuid
  number String @db.VarChar(100)
  date DateTime @db.Date
  contractId String? @map("contract_id") @db.Uuid
  contractSnapshot Json? @map("contract_snapshot") @db.JsonB
  quotationId String? @map("quotation_id") @db.Uuid
  quotationSnapshot Json? @map("quotation_snapshot") @db.JsonB
  startDate DateTime @map("start_date") @db.Date
  endDate DateTime? @map("end_date") @db.Date
  status WorkOrderStatus @default(DRAFT)
  revoked Boolean @default(false)
  version Int @default(0)
  createdById String @map("created_by_id") @db.Uuid
  createdByName String @map("created_by_name")
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedByName String? @map("updated_by_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  inspectors WorkOrderInspector[]
  history WorkOrderHistory[]
  @@unique([officeBranchId, number])
  @@index([officeBranchId, revoked, createdAt, id])
  // Inspector schedule lookup: non-revoked work orders of a branch filtered by
  // status, then narrowed by the requested period.
  @@index([officeBranchId, revoked, status])
  @@index([quotationId])
  @@map("work_order")
}

model WorkOrderInspector {
  id String @id @default(uuid()) @db.Uuid
  workOrderId String @map("work_order_id") @db.Uuid
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  /// Auth user ID of the inspector at creation time; null for legacy rows
  /// edited through the PATCH name-based contract before IDs were introduced.
  userId String? @map("user_id") @db.Uuid
  /// Display name snapshot from the FieldServiceUser read model (firstName + lastName).
  name String @db.VarChar(255)
  position Int
  @@unique([workOrderId, position], map: "work_order_inspectors_work_order_id_position_key")
  @@map("work_order_inspectors")
}

model WorkOrderSequence {
  officeBranchId String @map("office_branch_id") @db.Uuid
  year Int
  lastNumber Int @default(0) @map("last_number")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@id([officeBranchId, year])
  @@map("work_order_sequences")
}

model WorkOrderHistory {
  id String @id @default(uuid()) @db.Uuid
  workOrderId String @map("work_order_id") @db.Uuid
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  version Int
  action String @db.VarChar(20)
  beforeSnapshot Json? @map("before_snapshot") @db.JsonB
  snapshot Json @db.JsonB
  changes Json @db.JsonB
  createdById String @map("created_by_id") @db.Uuid
  createdByName String @map("created_by_name")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([workOrderId, version], map: "work_order_histories_work_order_id_version_key")
  @@map("work_order_histories")
}

/// Local Field Service read model of Auth users with section FIELD_SERVICE.
/// Rows exist only for users that are simultaneously in FIELD_SERVICE, active
/// and assigned to an office branch. The complete Auth user snapshot is stored
/// as one JSON document so field additions never force a table migration.
model FieldServiceUser {
  id              String   @id @db.Uuid
  officeBranchId  String   @map("office_branch_id") @db.Uuid
  user            Json     @db.JsonB
  sourceVersion   Int      @map("source_version")
  sourceCreatedAt DateTime @map("source_created_at")
  sourceUpdatedAt DateTime @map("source_updated_at")

  @@index([officeBranchId, sourceCreatedAt, id])
  @@map("field_service_users")
}

/// Last Auth user-snapshot version processed per user. Metadata only; it keeps
/// reordered or retried events from resurrecting a removed read-model row.
model FieldServiceUserSyncRevision {
  userId  String   @id @map("user_id") @db.Uuid
  version Int
  eventId String   @map("event_id") @db.Uuid

  @@map("field_service_user_sync_revisions")
}
