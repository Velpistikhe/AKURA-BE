generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum WorkOrderStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELED
  @@map("WorkOrderStatus")
}

model WorkOrder {
  id String @id @default(uuid()) @db.Uuid
  officeBranchId String @map("office_branch_id") @db.Uuid
  number String @db.VarChar(100)
  date DateTime @db.Date
  contractId String? @map("contract_id") @db.Uuid
  contractSnapshot Json? @map("contract_snapshot") @db.JsonB
  quotationId String? @map("quotation_id") @db.Uuid
  quotationSnapshot Json? @map("quotation_snapshot") @db.JsonB
  startDate DateTime @map("start_date") @db.Date
  endDate DateTime? @map("end_date") @db.Date
  status WorkOrderStatus @default(DRAFT)
  revoked Boolean @default(false)
  version Int @default(0)
  createdById String @map("created_by_id") @db.Uuid
  createdByName String @map("created_by_name")
  updatedById String? @map("updated_by_id") @db.Uuid
  updatedByName String? @map("updated_by_name")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  items WorkOrderItem[]
  inspectors WorkOrderInspector[]
  history WorkOrderHistory[]
  @@unique([officeBranchId, number])
  @@index([officeBranchId, revoked, createdAt, id])
  // Inspector schedule lookup: non-revoked work orders of a branch filtered by
  // status, then narrowed by the requested period.
  @@index([officeBranchId, revoked, status])
  @@index([quotationId])
  @@map("work_order")
}
model WorkOrderItem {
  id String @id @default(uuid()) @db.Uuid
  workOrderId String @map("work_order_id") @db.Uuid
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  itemSizeId String @map("item_size_id") @db.Uuid
  item Json @map("item") @db.JsonB
  quantityInspection Decimal @map("quantity_inspection") @db.Decimal(15, 3)
  quantityMaintenance Decimal @map("quantity_maintenance") @db.Decimal(15, 3)
  @@map("work_order_items")
}



model WorkOrderInspector {
  id String @id @default(uuid()) @db.Uuid
  workOrderId String @map("work_order_id") @db.Uuid
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  /// Auth user ID of the inspector at creation time; null for legacy rows
  /// edited through the PATCH name-based contract before IDs were introduced.
  userId String? @map("user_id") @db.Uuid
  /// Display name snapshot confirmed against the live Auth directory (firstName + lastName).
  name String @db.VarChar(255)
  position Int
  @@unique([workOrderId, position], map: "work_order_inspectors_work_order_id_position_key")
  @@map("work_order_inspectors")
}

model WorkOrderSequence {
  officeBranchId String @map("office_branch_id") @db.Uuid
  year Int
  lastNumber Int @default(0) @map("last_number")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  @@id([officeBranchId, year])
  @@map("work_order_sequences")
}

model WorkOrderHistory {
  id String @id @default(uuid()) @db.Uuid
  workOrderId String @map("work_order_id") @db.Uuid
  workOrder WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Restrict)
  version Int
  action String @db.VarChar(20)
  beforeSnapshot Json? @map("before_snapshot") @db.JsonB
  snapshot Json @db.JsonB
  changes Json @db.JsonB
  createdById String @map("created_by_id") @db.Uuid
  createdByName String @map("created_by_name")
  createdAt DateTime @default(now()) @map("created_at")
  @@unique([workOrderId, version], map: "work_order_histories_work_order_id_version_key")
  @@map("work_order_histories")
}

/// Audit trail for every write in this service.
///
/// The tax snapshot itself is recorded in `TaxEvent`. This table records
/// who changed the data, which the event payload does not carry. A single
/// generic table keeps the audit trail uniform across the whole platform, so a
/// new module is audited without a schema migration.
///
/// The rows are append-only: there is no update or delete path in the
/// application.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  module         String   @db.VarChar(50)
  entityType     String   @map("entity_type") @db.VarChar(50)
  entityId       String   @map("entity_id") @db.Uuid
  /// The version of the entity state this entry describes.
  ///
  /// Entities that carry their own version column record that number. The
  /// entities without one record the timestamp of the change, so every write
  /// still produces exactly one entry. A BigInt holds both.
  version        BigInt
  action         String   @db.VarChar(20)
  before         Json?    @db.JsonB
  after          Json     @db.JsonB
  officeBranchId String?  @map("office_branch_id") @db.Uuid
  createdById    String   @map("created_by_id") @db.Uuid
  createdByName  String   @map("created_by_name")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([entityType, entityId, version])
  @@index([module, entityType, entityId, createdAt])
  @@index([officeBranchId, createdAt])
  @@map("audit_logs")
}