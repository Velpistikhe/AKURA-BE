datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserSection {
  ACCOUNTING
  FINANCE
  HRD_MANAGEMENT
  MARKETING
  FIELD_SERVICE

  @@map("user_section")
}

enum UserRole {
  USER
  ADMIN
  APP_MANAGER

  @@map("user_role")
}

model Menu {
  isDeleted Boolean @default(false) @map("is_deleted")
  id        String     @id @default(uuid()) @db.Uuid
  key       String     @unique
  label     String
  hasItem   Boolean    @default(false) @map("has_item")
  order     Int        @default(0)
  isActive  Boolean    @default(true) @map("is_active")
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")
  items     MenuItem[]

  @@map("menus")
}

model MenuItem {
  isDeleted Boolean @default(false) @map("is_deleted")
  id        String       @id @default(uuid()) @db.Uuid
  menuId    String       @map("menu_id") @db.Uuid
  menu      Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  key       String       @unique
  label     String
  order     Int          @default(0)
  isActive  Boolean      @default(true) @map("is_active")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  accesses  MenuAccess[]

  @@index([menuId])
  @@map("menu_items")
}

model MenuAccess {
  isDeleted Boolean @default(false) @map("is_deleted")
  id         String       @id @default(uuid()) @db.Uuid
  menuItemId String       @map("menu_item_id") @db.Uuid
  menuItem   MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  role       UserRole?
  section    UserSection?
  createdAt  DateTime     @default(now()) @map("created_at")
  updatedAt  DateTime     @updatedAt @map("updated_at")

  @@unique([menuItemId, role, section])
  @@index([role, section])
  @@map("menu_accesses")
}

model OfficeBranch {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  address     String
  telp        String
  email       String
  /// A partial unique index enforces a single true value.
  isHead      Boolean  @default(false) @map("is_head")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("office_branches")
}

model Tax {
  id             String @id @default(uuid()) @db.Uuid
  officeBranchId String @map("office_branch_id") @db.Uuid
  percentage     Decimal @db.Decimal(5, 2)
  effectiveFrom  DateTime @map("effective_from") @db.Date
  effectiveUntil DateTime? @map("effective_until") @db.Date
  createdById    String @map("created_by_id") @db.Uuid
  createdByName  String @map("created_by_name")
  updatedById    String? @map("updated_by_id") @db.Uuid
  updatedByName  String? @map("updated_by_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([officeBranchId, effectiveFrom])
  @@map("taxes")
}

/// Audit trail for every write in this service.
///
/// The other services keep a dedicated history table per entity. A single
/// generic table keeps the audit trail uniform across the whole platform: the
/// module and the entity are named, so a new module is audited without a
/// schema migration.
///
/// The rows are append-only. There is no update or delete path in the
/// application, and the version column is unique per entity so a retried
/// write cannot create a second entry for the same state.
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  module         String   @db.VarChar(50)
  entityType     String   @map("entity_type") @db.VarChar(50)
  entityId       String   @map("entity_id") @db.Uuid
  /// The version of the entity state this entry describes.
  ///
  /// Entities that carry their own version column record that number. The
  /// entities without one record the timestamp of the change, so every write
  /// still produces exactly one entry. A BigInt holds both.
  version        BigInt
  action         String   @db.VarChar(20)
  before         Json?    @db.JsonB
  after          Json     @db.JsonB
  officeBranchId String?  @map("office_branch_id") @db.Uuid
  createdById    String   @map("created_by_id") @db.Uuid
  createdByName  String   @map("created_by_name")
  createdAt      DateTime @default(now()) @map("created_at")

  // Not unique: these entities have no version column, so the entry carries
  // the millisecond timestamp of the change. Two writes to the same entity
  // inside one millisecond would collide on a unique constraint and fail the
  // write. The entry is written in the same transaction as the change, which
  // already guarantees exactly one entry per committed write.
  @@index([entityType, entityId, version])
  @@index([module, entityType, entityId, createdAt])
  @@index([officeBranchId, createdAt])
  @@map("audit_logs")
}