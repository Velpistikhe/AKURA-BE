# Local/non-serverless only. Vercel does not need PORT to be set manually.
PORT=5002
NODE_ENV=development

# Security & Secrets
GATEWAY_SECRET=replace_with_app_manager_service_only_secret

# Database
DATABASE_URL=postgresql://postgres:admin@localhost:5432/akura_auth?schema=public

# JWT
JWT_ISSUER=akura-auth
JWT_AUDIENCE=akura-api

# Service Endpoints
API_GATEWAY_URL=http://localhost:5000
