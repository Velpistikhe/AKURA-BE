PORT=5002
NODE_ENV=development

GATEWAY_SECRET=replace_with_app_manager_service_only_secret

# Fully local stack:
DATABASE_URL=postgresql://postgres:admin@localhost:5432/akura_app_manager?schema=public
# Hybrid: local App Manager service, Neon development branch (*.neon.tech is allowed in development).
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/akura_app_manager?sslmode=require

# Fully local stack:
API_GATEWAY_URL=http://localhost:5000
# Hybrid: validate tokens against the deployed gateway (akura-api-gateway.vercel.app).
# API_GATEWAY_URL=https://akura-api-gateway.vercel.app