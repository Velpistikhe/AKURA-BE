# ==========================================
# Akura - App Manager Service
# ==========================================
# Copy this file to `.env` and replace every placeholder with a real value:
#
#   cp .env.example .env
#
# The `.env` file is git-ignored and must never be committed.
#
# This file documents the DEVELOPMENT configuration. Every value points at a
# local service, so running the service locally can never reach a deployed
# system. For a deployment, set the variables in the hosting dashboard
# instead; do not copy this file to the server.
#
# Generate a secret with:
#   openssl rand -base64 48
#
# ==========================================

# ==========================================
# Server
# ==========================================
# Local/non-serverless only. Vercel does not need PORT to be set manually.
PORT=5002
NODE_ENV=development

# ==========================================
# Security & Secrets
# ==========================================
# Must match APP_MANAGER_SERVICE_GATEWAY_SECRET in the API Gateway.
GATEWAY_SECRET=replace_with_app_manager_service_only_secret

# ==========================================
# Database
# ==========================================
# The local development database. Never point this at a deployed database.
#
# After changing the schema, apply the database-level invariants that
# Prisma cannot express:
#   npm run db:push
#   npm run db:migrate
DATABASE_URL=postgresql://postgres:admin@localhost:5432/akura_app_manager?schema=public