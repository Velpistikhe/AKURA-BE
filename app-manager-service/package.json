{
  "name": "app-manager-service",
  "version": "1.0.0",
  "description": "Modular administration microservice for Akura",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && rimraf dist && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate-rbac": "node scripts/migrate-rbac.mjs && prisma generate",
    "db:migrate-menu-item-accesses": "node scripts/migrate-menu-item-accesses.mjs && prisma generate",
    "db:migrate-menu-has-item": "node scripts/migrate-menu-has-item-remove-item-path.mjs && prisma generate",
    "db:push": "prisma db push",
    "test:api": "node tests/app-manager-verification.mjs",
    "test:all": "node tests/all-endpoints-verification.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "helmet": "^7.2.0",
    "jose": "^6.1.0",
    "winston": "^3.19.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "prisma": "^5.22.0",
    "rimraf": "^5.0.10",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
