# ==========================================
# Akura - API Gateway
# ==========================================
# Copy this file to `.env` and replace every placeholder with a real value:
#
#   cp .env.example .env
#
# The `.env` file is git-ignored and must never be committed.
#
# This file documents the DEVELOPMENT configuration. Every value points at a
# local service, so running the gateway locally can never reach a deployed
# system. For a deployment, set the variables in the hosting dashboard
# instead; do not copy this file to the server.
#
# Generate a secret with:
#   openssl rand -base64 48
#
# ==========================================

# ==========================================
# Server
# ==========================================
# Local/non-serverless only. Vercel does not need PORT to be set manually.
PORT=5000
NODE_ENV=development

# ==========================================
# CORS
# ==========================================
# Use exact frontend origin without trailing slash. Separate multiple origins with commas.
# "*" is rejected in production because the API sends credentialed responses.
CORS_ORIGIN=*

# ==========================================
# Rate Limiting
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
# Tighter per-IP limit for POST /api/v1/auth/{login,register,refresh-token}
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# ==========================================
# Security & Secrets
# ==========================================
# Every downstream service must use a different secret. The gateway rejects
# a configuration where two services share one.
AUTH_SERVICE_GATEWAY_SECRET=replace_with_auth_service_only_secret
APP_MANAGER_SERVICE_GATEWAY_SECRET=replace_with_app_manager_service_only_secret
MARKETING_SERVICE_GATEWAY_SECRET=replace_with_marketing_service_only_secret
FINANCE_SERVICE_GATEWAY_SECRET=replace_with_finance_service_only_secret
FIELDSERVICE_SERVICE_GATEWAY_SECRET=replace_with_fieldservice_service_only_secret

# ==========================================
# JWT
# ==========================================
JWT_ISSUER=akura-auth
JWT_AUDIENCE=akura-api

# ==========================================
# Microservice Target Endpoints
# ==========================================
AUTH_JWKS_URL=http://localhost:5001/.well-known/jwks.json
AUTH_SERVICE_URL=http://localhost:5001
APP_MANAGER_SERVICE_URL=http://localhost:5002
MARKETING_SERVICE_URL=http://localhost:5003
FINANCE_SERVICE_URL=http://localhost:5004
FIELDSERVICE_SERVICE_URL=http://localhost:5005