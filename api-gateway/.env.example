PORT=5000
NODE_ENV=development
# Hosts this development run may reach besides the local machine. The hosted
# development environment (the Neon branch and the deployed services) is listed
# here by name, so an unlisted target is still refused at startup.
# Comma-separated host names, for example: ep-xxx.us-east-2.aws.neon.tech,akura-api-gateway.vercel.app
DEV_ALLOWED_REMOTE_HOSTS=

CORS_ORIGIN=*

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX_REQUESTS=10

AUTH_SERVICE_GATEWAY_SECRET=replace_with_auth_service_only_secret
APP_MANAGER_SERVICE_GATEWAY_SECRET=replace_with_app_manager_service_only_secret
MARKETING_SERVICE_GATEWAY_SECRET=replace_with_marketing_service_only_secret
FINANCE_SERVICE_GATEWAY_SECRET=replace_with_finance_service_only_secret
FIELDSERVICE_SERVICE_GATEWAY_SECRET=replace_with_fieldservice_service_only_secret

JWT_ISSUER=akura-auth
JWT_AUDIENCE=akura-api

AUTH_JWKS_URL=http://localhost:5001/.well-known/jwks.json
AUTH_SERVICE_URL=http://localhost:5001
APP_MANAGER_SERVICE_URL=http://localhost:5002
MARKETING_SERVICE_URL=http://localhost:5003
FINANCE_SERVICE_URL=http://localhost:5004
FIELDSERVICE_SERVICE_URL=http://localhost:5005