# Local/non-serverless only. Vercel does not need PORT to be set manually.
PORT=5000
NODE_ENV=development
# Use exact frontend origin without trailing slash. Separate multiple origins with commas.
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Security & Secrets
AUTH_SERVICE_GATEWAY_SECRET=replace_with_auth_service_only_secret
APP_MANAGER_SERVICE_GATEWAY_SECRET=replace_with_app_manager_service_only_secret
MARKETING_SERVICE_GATEWAY_SECRET=replace_with_marketing_service_only_secret
FINANCE_SERVICE_GATEWAY_SECRET=replace_with_finance_service_only_secret
FIELDSERVICE_SERVICE_GATEWAY_SECRET=replace_with_fieldservice_service_only_secret

# JWT
JWT_ISSUER=akura-auth
JWT_AUDIENCE=akura-api

# Microservice Target Endpoints
AUTH_JWKS_URL="https://akura-auth-service.vercel.app/.well-known/jwks.json"
AUTH_SERVICE_URL="https://akura-auth-service.vercel.app"
APP_MANAGER_SERVICE_URL="https://akura-app-manager-service.vercel.app"
MARKETING_SERVICE_URL="https://akura-marketing-service.vercel.app"
FINANCE_SERVICE_URL="https://akura-finance-service.vercel.app"
FIELDSERVICE_SERVICE_URL="https://akura-fieldservice-service.vercel.app"
