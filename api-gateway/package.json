{
  "name": "api-gateway",
  "version": "1.0.0",
  "description": "Express TypeScript API Gateway for Microservices Architecture",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "rimraf dist && tsc",
    "verify:openapi": "npm run build && node scripts/verify-openapi.cjs",
    "verify:service-boundaries": "npm run build && node scripts/verify-service-boundaries.cjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "express",
    "typescript",
    "api-gateway",
    "microservices",
    "proxy"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "http-proxy-middleware": "^3.0.0",
    "jose": "^6.1.0",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "swagger-ui-dist": "^5.32.14",
    "swagger-ui-express": "^4.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^10.0.0",
    "rimraf": "^5.0.7",
    "tsx": "^4.16.0",
    "typescript": "^5.5.2"
  }
}
