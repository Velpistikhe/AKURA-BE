
{
  "name": "akura-cline-anthropic-setup",
  "version": "2.0.0",
  "target": {
    "os": "Windows",
    "editor": "VS Code",
    "agent": "Cline extension",
    "provider": "Anthropic Claude Sonnet",
    "project": "Akura; six independent Node.js services; npm; Express 4; TypeScript; CommonJS runtime"
  },
  "principles": {
    "serena": "optional-not-required",
    "additionalRuntimeInstallation": false,
    "rootPackageJson": false,
    "sharedRootNpmScripts": false,
    "contextStrategy": "selective",
    "validation": "per-service"
  },
  "files": [
    ".ai-context/ARCHITECTURE.md",
    ".ai-context/COMMANDS.md",
    ".ai-context/DECISIONS.md",
    ".ai-context/INDEX.md",
    ".ai-context/MODULE-MAP.md",
    ".ai-context/PROJECT.md",
    ".clinerules/00-core.md",
    ".clinerules/01-context-and-token.md",
    ".clinerules/02-node-express.md",
    ".clinerules/03-mixed-js-ts.md",
    ".clinerules/04-testing-and-safety.md",
    ".clinerules/05-memory-policy.md",
    ".clinerules/workflows/onboard-project.md",
    ".clinerules/workflows/implement-feature.md",
    ".clinerules/workflows/debug-targeted.md",
    ".clinerules/workflows/refactor-safe.md",
    ".clinerules/workflows/review-diff.md",
    ".clinerules/workflows/refresh-context.md",
    ".project-map/api-endpoints.md",
    ".project-map/architecture.md",
    ".project-map/database-schema.md",
    ".project-map/decisions.md",
    ".project-map/modules.md",
    ".project-map/security-model.md",
    ".project-map/service-dependencies.md",
    ".project-map/unknowns.md",
    ".clineignore",
    ".gitignore",
    "README-ID.md"
  ],
  "excluded": [
    ".cline/",
    ".serena/",
    "scripts/install-serena.ps1",
    "scripts/print-mcp-entry.ps1",
    "scripts/show-serena-command.ps1",
    ".ai-context/TASK-STATE.md"
  ]
}
