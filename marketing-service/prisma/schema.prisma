datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum StaffTitle {
  mr
  mrs

  @@map("staff_title")
}

model Company {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  normalizeName String         @map("normalize_name")
  type          String
  address       String
  hasContract   Boolean        @default(false) @map("has_contract")
  revoked       Boolean        @default(false)
  version       Int            @default(0)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  staffs        CompanyStaff[]

  @@index([revoked])
  @@map("companies")
}

model CompanyStaff {
  id            String     @id @default(uuid()) @db.Uuid
  companyId     String     @map("company_id") @db.Uuid
  company       Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  normalizeName String     @map("normalize_name")
  title         StaffTitle
  telp          String?
  email         String?
  revoked       Boolean    @default(false)
  version       Int        @default(0)
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([revoked])
  @@map("company_staffs")
}

model Service {
  id        String         @id @default(uuid()) @db.Uuid
  code      String         @unique
  name      String
  hasService Boolean      @default(false) @map("has_service")
  maintenanceId String?    @map("maintenance_id") @db.Uuid
  maintenance   Maintenance? @relation(fields: [maintenanceId], references: [id], onDelete: SetNull)
  isActive  Boolean        @default(true) @map("is_active")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  scopes    ServiceScope[]
  itemCatalog Item[]

  @@map("services")
  @@index([maintenanceId])
}

model ServiceScope {
  id        String   @id @default(uuid()) @db.Uuid
  serviceId String   @map("service_id") @db.Uuid
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  scope     String
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([serviceId, scope])
  @@index([serviceId])
  @@index([revoked])
  @@map("service_scopes")
}

model Maintenance {
  id        String             @id @default(uuid()) @db.Uuid
  name      String
  isActive  Boolean            @default(true) @map("is_active")
  createdAt DateTime           @default(now()) @map("created_at")
  updatedAt DateTime           @updatedAt @map("updated_at")
  scopes    MaintenanceScope[]
  services  Service[]

  @@map("maintenances")
}

model MaintenanceScope {
  id            String      @id @default(uuid()) @db.Uuid
  maintenanceId String      @map("maintenance_id") @db.Uuid
  maintenance   Maintenance @relation(fields: [maintenanceId], references: [id], onDelete: Cascade)
  scope         String
  revoked       Boolean     @default(false)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@unique([maintenanceId, scope])
  @@index([maintenanceId])
  @@index([revoked])
  @@map("maintenance_scopes")
}

model Item {
  id           String            @id @default(uuid()) @db.Uuid
  name         String
  serviceId    String         @map("service_id") @db.Uuid
  service      Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  isActive     Boolean           @default(true) @map("is_active")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  sizes        ItemSize[]

  @@map("items")
}

model ItemSize {
  id        String   @id @default(uuid()) @db.Uuid
  itemId    String   @map("item_id") @db.Uuid
  item      Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  size      String
  priceServicePrimary       Decimal  @default(0) @map("price_service_primary") @db.Decimal(18, 2)
  priceServiceSisterCompany Decimal  @default(0) @map("price_service_sister_company") @db.Decimal(18, 2)
  priceMaintenancePrimary       Decimal? @map("price_maintenance_primary") @db.Decimal(18, 2)
  priceMaintenanceSisterCompany Decimal? @map("price_maintenance_sister_company") @db.Decimal(18, 2)
  isActive  Boolean  @default(true) @map("is_active")
  version   Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([itemId, size])
  @@index([itemId])
  @@index([isActive])
  @@map("item_sizes")
}
