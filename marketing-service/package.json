{
    "name":  "marketing-service",
    "version":  "1.0.0",
    "description":  "Akura marketing microservice for company and service management",
    "main":  "dist/server.js",
    "scripts":  {
                    "dev":  "tsx watch src/server.ts",
                    "build":  "prisma generate \u0026\u0026 rimraf dist \u0026\u0026 tsc",
                    "start":  "node dist/server.js",
                    "typecheck":  "tsc --noEmit",
                    "test":  "node --test --test-concurrency=1 tests/*.test.cjs",
                    "test:concurrency":  "node tests/marketing-concurrency-verification.cjs",
                    "test:inspection":  "node tests/inspection-scope-verification.cjs",
                    "test:all":  "npm run typecheck \u0026\u0026 npm test \u0026\u0026 npm run test:concurrency \u0026\u0026 npm run test:inspection",
                    "db:generate":  "prisma generate",
                    "db:push":  "prisma db push"
                },
    "dependencies":  {
                         "@aws-sdk/client-s3":  "^3.1131.0",
                         "@aws-sdk/s3-request-presigner":  "^3.1131.0",
                         "@prisma/client":  "^5.22.0",
                         "cookie-parser":  "^1.4.7",
                         "cors":  "^2.8.6",
                         "dotenv":  "^16.6.1",
                         "exceljs":  "^4.4.0",
                         "express":  "^4.22.2",
                         "helmet":  "^7.2.0",
                         "jose":  "^6.1.0",
                         "multer":  "^2.3.0",
                         "pdfkit":  "^0.20.2",
                         "winston":  "^3.19.0",
                         "yauzl":  "^3.4.0",
                         "zod":  "^3.25.76"
                     },
    "devDependencies":  {
                            "@types/cookie-parser":  "^1.4.10",
                            "@types/cors":  "^2.8.19",
                            "@types/express":  "^4.17.25",
                            "@types/multer":  "^2.2.0",
                            "@types/node":  "^20.19.43",
                            "@types/pdfkit":  "^0.17.6",
                            "@types/yauzl":  "^3.4.0",
                            "prisma":  "^5.22.0",
                            "rimraf":  "^5.0.10",
                            "tsx":  "^4.23.12",
                            "typescript":  "^5.9.3"
                        }
}
