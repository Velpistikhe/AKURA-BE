{
  "name": "marketing-service",
  "version": "1.0.0",
  "description": "Akura marketing microservice for company and service management",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && rimraf dist && tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "test:api": "node tests/api-verification.mjs",
    "test:quotation": "tsc && node tests/quotation-verification.cjs",
    "test:quotation-approval": "tsc && node tests/quotation-approval-verification.cjs",
    "test:quotation-http": "tsc && node tests/quotation-http-verification.cjs",
    "test:quotation-number": "tsc && node tests/quotation-number-verification.cjs",
    "test:item-size-reuse": "tsc && node tests/item-size-reuse-verification.cjs",
    "test:item-size-list": "tsc && node tests/item-size-list-verification.cjs",
    "test:item-uom": "tsc && node tests/item-uom-verification.cjs",
    "test:quotation-price-options": "tsc && node tests/quotation-price-options-verification.cjs",
    "test:catalog-pricing": "tsc && node tests/catalog-pricing-verification.cjs",
    "test:contract-excel": "tsc && node tests/contract-excel-verification.cjs",
    "test:company-staff-history": "tsc && node tests/company-staff-history-verification.cjs",
    "test:company-history": "tsc && node tests/company-history-verification.cjs",
    "test:company-contract-response": "tsc && node tests/company-contract-response-verification.cjs",
    "test:quotation-standard-prices": "tsc && node tests/quotation-standard-prices.cjs",
    "test:tax-events": "tsc && node --test tests/tax-events.test.cjs",
    "test:tax-events-http": "tsc && node --test tests/tax-events-http.test.cjs",
    "tax:schema": "node scripts/apply-tax-schema.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "@aws-sdk/s3-request-presigner": "^3.1131.0",
    "@prisma/client": "^5.22.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^4.22.2",
    "helmet": "^7.2.0",
    "jose": "^6.1.0",
    "multer": "^2.3.0",
    "pdfkit": "^0.20.2",
    "winston": "^3.19.0",
    "yauzl": "^3.4.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.19.43",
    "@types/pdfkit": "^0.17.6",
    "@types/yauzl": "^3.4.0",
    "prisma": "^5.22.0",
    "rimraf": "^5.0.10",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
