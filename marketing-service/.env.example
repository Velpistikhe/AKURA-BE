# ==========================================
# Akura - Marketing Service
# ==========================================
# Copy this file to `.env` and replace every placeholder with a real value:
#
#   cp .env.example .env
#
# The `.env` file is git-ignored and must never be committed.
#
# This file documents the DEVELOPMENT configuration. Every value points at a
# local service, so running the service locally can never reach a deployed
# system. For a deployment, set the variables in the hosting dashboard
# instead; do not copy this file to the server.
#
# Generate a secret with:
#   openssl rand -base64 48
#
# ==========================================

# ==========================================
# Server
# ==========================================
# Local/non-serverless only. Vercel does not need PORT to be set manually.
PORT=5003
NODE_ENV=development

# ==========================================
# Security & Secrets
# ==========================================
# Must match MARKETING_SERVICE_GATEWAY_SECRET in the API Gateway.
GATEWAY_SECRET=replace_with_marketing_service_only_secret
# Shared with Finance for the tax read-model delivery (min 32 chars).
TAX_SYNC_SECRET=replace-with-shared-secret-at-least-32-characters
# Shared with Auth for the user read-model sync (min 32 chars).
USER_SYNC_SECRET=replace-with-shared-secret-at-least-32-characters
# Shared with Field Service for the Work Order revoke callback (min 32 chars).
# Must match the Field Service WORK_ORDER_SYNC_SECRET. Without it, revoking a
# quotation-based Work Order fails with 503 because Marketing cannot be told
# to clear the quotation link.
WORK_ORDER_SYNC_SECRET=replace-with-shared-secret-at-least-32-characters

# ==========================================
# Development direct access
# ==========================================
# The local Marketing microfrontend calls this service directly
# (localhost:5003) with Authorization: Bearer instead of the local gateway.
# JWT, profile, section/role and branch checks remain mandatory. Set true only
# in development; production must keep this false (the gateway is the only
# caller).
# DIRECT_MFE_ORIGIN is the only browser origin allowed to call directly.
DIRECT_MFE_ACCESS=true
DIRECT_MFE_ORIGIN=http://localhost:4173

# ==========================================
# Database
# ==========================================
# The local development database. Never point this at a deployed database.
DATABASE_URL=postgresql://postgres:admin@localhost:5432/akura_marketing?schema=public

# ==========================================
# JWT
# ==========================================
JWT_ISSUER=akura-auth
JWT_AUDIENCE=akura-api

# ==========================================
# Service Endpoints
# ==========================================
# The local API Gateway. Used for JWKS, /auth/me profile checks and internal
# references.
API_GATEWAY_URL=http://localhost:5000

# ==========================================
# Storage
# ==========================================
# The local development object storage. Point this at the local bucket, or
# leave the S3 variables unset when the quotations do not need PDF storage.
AWS_ENDPOINT_URL_S3=http://localhost:9000
AWS_ACCESS_KEY_ID=replace-with-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-storage-secret
AWS_REGION=us-east-2
AWS_S3_BUCKET=akura