PORT=5003
NODE_ENV=development

GATEWAY_SECRET=replace_with_marketing_service_only_secret
TAX_SYNC_SECRET=replace-with-shared-secret-at-least-32-characters
WORK_ORDER_SYNC_SECRET=replace-with-shared-secret-at-least-32-characters

# Fully local stack:
DATABASE_URL=postgresql://postgres:admin@localhost:5432/akura_marketing?schema=public
# Hybrid: local Marketing service, Neon development branch (*.neon.tech is allowed in development).
# DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx.us-east-2.aws.neon.tech/akura_marketing?sslmode=require

JWT_ISSUER=akura-auth
JWT_AUDIENCE=akura-api

# Fully local stack:
API_GATEWAY_URL=http://localhost:5000
# Hybrid: validate tokens against the deployed gateway (akura-api-gateway.vercel.app).
# The browser still calls this service directly on PORT; only auth/JWKS and /auth/me use the gateway.
# API_GATEWAY_URL=https://akura-api-gateway.vercel.app

AWS_ENDPOINT_URL_S3=http://localhost:9000
AWS_ACCESS_KEY_ID=replace-with-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-storage-secret
AWS_REGION=us-east-2
AWS_S3_BUCKET=akura