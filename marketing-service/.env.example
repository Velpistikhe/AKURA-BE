# All API traffic uses the API Gateway in development and production.
# GATEWAY_SECRET must match this service credential in the gateway.
# Local/non-serverless only. Vercel does not need PORT to be set manually.
PORT=5003
NODE_ENV=development

# Security & Secrets
GATEWAY_SECRET=replace_with_marketing_service_only_secret
TAX_SYNC_SECRET=replace-with-shared-secret-at-least-32-characters
# Shared with Auth Service for the user read-model sync (min 32 chars).
USER_SYNC_SECRET=replace-with-shared-secret-at-least-32-characters

# Database
DATABASE_URL=postgresql://postgres:admin@localhost:5432/akura_marketing?schema=public

# JWT
JWT_ISSUER=akura-auth
JWT_AUDIENCE=akura-api

# Service Endpoints
API_GATEWAY_URL=http://localhost:5000

# Storage
AWS_ENDPOINT_URL_S3=https://your-neon-storage-endpoint
AWS_ACCESS_KEY_ID=replace-with-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-storage-secret
AWS_REGION=us-east-2
AWS_S3_BUCKET=akura
