# All API traffic uses the API Gateway in development and production.
# GATEWAY_SECRET must match this service credential in the gateway.
# Local/non-serverless only. Vercel does not need PORT to be set manually.
PORT=5003
NODE_ENV=development

# Security & Secrets
GATEWAY_SECRET=replace_with_marketing_service_only_secret
TAX_SYNC_SECRET=replace-with-shared-secret-at-least-32-characters
# Shared with Auth Service for the user read-model sync (min 32 chars).
USER_SYNC_SECRET=replace-with-shared-secret-at-least-32-characters
# Shared with Field Service for the Work Order revoke callback (min 32 chars).
# Must match the Field Service WORK_ORDER_SYNC_SECRET. Without it, revoking a
# quotation-based Work Order fails with 503 because Marketing cannot be told
# to clear the quotation link.
WORK_ORDER_SYNC_SECRET=replace-with-shared-secret-at-least-32-characters

# Development direct access: the local Marketing microfrontend calls this service
# directly (localhost:5003) with Authorization: Bearer instead of the local gateway.
# JWT, profile, section/role and branch checks remain mandatory. Set true only in
# development; production must keep this false (the gateway is the only caller).
# DIRECT_MFE_ORIGIN is the only browser origin allowed to call directly.
DIRECT_MFE_ACCESS=true
DIRECT_MFE_ORIGIN=http://localhost:4173

# Database
DATABASE_URL=postgresql://postgres:admin@localhost:5432/akura_marketing?schema=public

# JWT
JWT_ISSUER=akura-auth
JWT_AUDIENCE=akura-api

# Service Endpoints
# Gateway used for JWKS, /auth/me profile checks and internal references.
# In the hybrid development topology point this to the Vercel gateway so the
# locally running Marketing service validates tokens issued by Auth on Vercel.
API_GATEWAY_URL=http://localhost:5000

# Storage
AWS_ENDPOINT_URL_S3=https://your-neon-storage-endpoint
AWS_ACCESS_KEY_ID=replace-with-storage-access-key
AWS_SECRET_ACCESS_KEY=replace-with-storage-secret
AWS_REGION=us-east-2
AWS_S3_BUCKET=akura
